# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real credentials to version control

# ================================
# Database & Backend
# ================================
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
# VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (admin only, never expose to client)

# ================================
# Authentication
# ================================
# VITE_JWT_SECRET=your-jwt-secret-key

# ================================
# Payment Gateway (iyzico/Papara)
# ================================
# VITE_PAYMENT_API_KEY=your-payment-api-key
# VITE_PAYMENT_SECRET_KEY=your-payment-secret-key
# VITE_PAYMENT_SANDBOX=true

# ================================
# Maps & Geolocation
# ================================
# VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ================================
# Storage (AWS S3/Cloudinary)
# ================================
# VITE_STORAGE_PROVIDER=supabase
# VITE_AWS_S3_BUCKET=your-bucket-name
# VITE_AWS_ACCESS_KEY_ID=your-access-key
# VITE_AWS_SECRET_ACCESS_KEY=your-secret-key
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_API_KEY=your-api-key

# ================================
# Firebase (Push Notifications / FCM)
# ================================
# VITE_FIREBASE_API_KEY=your-firebase-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
# VITE_FIREBASE_APP_ID=your-firebase-app-id
# VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key

# ================================
# Real-time Communication
# ================================
# VITE_SOCKET_IO_URL=http://localhost:3001

# ================================
# Application Settings
# ================================
VITE_APP_ENV=development
VITE_APP_NAME=KampusAbla
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173/api

# ================================
# Feature Flags
# ================================
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_LOCATION_TRACKING=true
# VITE_ENABLE_PAYMENTS=false
